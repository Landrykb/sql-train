# ---------- build frontend (Next.js) -----------------------
    FROM node:20 AS frontend-builder
    WORKDIR /app
    COPY . .
    RUN corepack enable \
     && pnpm i -r \
     && pnpm --filter frontend build \
     && pnpm --filter frontend export   # static WASM demo for gh‑pages
    
    # ---------- build backend (FastAPI) ------------------------
    FROM python:3.11-slim AS backend-builder
    WORKDIR /app
    COPY packages/backend/requirements.txt ./
    RUN pip install --no-cache-dir -r requirements.txt
    COPY packages/backend /app/packages/backend
    
    # ---------- final runtime image ---------------------------
    FROM debian:bookworm-slim
    WORKDIR /srv/besa
    RUN apt-get update && apt-get install -y libpq5 && rm -rf /var/lib/apt/lists/*
    
    # copy static frontend and backend python env
    COPY --from=frontend-builder /app/packages/frontend/.next .next
    COPY --from=frontend-builder /app/packages/frontend/public ./public
    COPY --from=backend-builder  /usr/local/lib/python3.11 /usr/local/lib/python3.11
    COPY --from=backend-builder  /usr/local/bin            /usr/local/bin
    COPY packages/backend /srv/besa/packages/backend
    
    ENV PYTHONUNBUFFERED=1 PORT=8080
    EXPOSE 8080
    CMD ["python","-m","uvicorn","packages.backend.app.main:app","--host","0.0.0.0","--port","8080"]
