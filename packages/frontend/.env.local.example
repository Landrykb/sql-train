# Backend API URL — your Render backend URL (no trailing slash)
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com

# Supabase — for cross-device progress sync & fast GitHub auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# PostHog — anonymous product analytics (optional, admin-only dashboards)
# Leave blank to disable analytics entirely.
# Sign up free at https://posthog.com (1M events/month free tier)
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Bleepx LLM brain (optional — set LLM_DISABLED=true to use free local answers only)
# OpenRouter (https://openrouter.ai) has free model endpoints. Use :free for the free variant.
# openrouter/free is a router that picks an available free model automatically.
# LLM_API_KEY stays server-side; it never ships to the browser.
LLM_DISABLED=false
LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
LLM_API_KEY=sk-or-...
LLM_MODEL=openrouter/free
LLM_REFERER=https://your-site.vercel.app
# LLM_MAX_TOKENS controls how long the model's reply can be before it gets cut off.
# 500 tokens is usually enough for a full natural answer. Lower it to save free-tier quota.
LLM_MAX_TOKENS=500
# LLM_MAX_HISTORY = how many previous chat turns are sent with each question.
LLM_MAX_HISTORY=5
# LLM_RATE_LIMIT_PER_MIN = max LLM calls per IP per minute to protect the free tier.
LLM_RATE_LIMIT_PER_MIN=15
# LLM_MAX_QUESTION_LENGTH = max characters the user can type in one message.
LLM_MAX_QUESTION_LENGTH=2000
# LLM_MAX_BODY_SIZE = max request payload size in bytes (JSON body sent by the frontend).
# 50 KB is plenty for the chat history; it does NOT limit the response length.
LLM_MAX_BODY_SIZE=50000
